Options -Indexes
DirectoryIndex index.php

# Never expose secrets, source-control metadata, or database schema.
<FilesMatch "^(config\.php|config\.example\.php|schema\.sql|\.gitignore|\.env|composer\.(json|lock))$">
  Require all denied
</FilesMatch>

# Deny access to hidden files and directories.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule "(^|/)\." - [F,L]
</IfModule>

# Prevent direct requests to PHP source directories; PHP includes still work.
<IfModule mod_rewrite.c>
  RewriteRule ^(app|legacy)(/|$) - [F,L]
</IfModule>
