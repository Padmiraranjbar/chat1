Options -Indexes
DirectoryIndex index.php

# Never expose secrets, source-control metadata, or database schema.
<FilesMatch "^(config\.php|config\.example\.php|schema\.sql|\.gitignore|\.env|composer\.(json|lock))$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Keep certificate validation available on hosts that use ACME/Let's Encrypt.
  RewriteRule ^\.well-known/ - [L]
  # Deny access to other hidden files and directories.
  RewriteRule "(^|/)\." - [F,L]
  # Legacy files are included by PHP, not requested directly by browsers.
  RewriteRule ^(app|legacy)(/|$) - [F,L]
</IfModule>
